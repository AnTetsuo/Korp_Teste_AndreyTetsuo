# Shared Postgres instance (container korp-db) - one database per service
POSTGRES_DB=korp
POSTGRES_USER=korp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Stock service - "stock" database, "stock" schema
STOCK_POSTGRES_DB=stock
STOCK_API_PORT=3000
ConnectionStrings__Stock=Host=localhost;Port=5432;Database=stock;Username=korp;Password=;Search Path=stock

# Invoicing service - "invoicing" database, "invoicing" schema
INVOICING_POSTGRES_DB=invoicing
INVOICING_API_PORT=3001
ConnectionStrings__Invoicing=Host=localhost;Port=5432;Database=invoicing;Username=korp;Password=;Search Path=invoicing

# Shared
API_DOCS_ENABLED=false

# RabbitMQ (container korp-rabbitmq)
# RABBITMQ_* configure the broker container; compose maps them into invoicing-api as RabbitMq__*.
# The RabbitMq__* keys below are for host-side `dotnet run`, which talks to localhost instead.
RABBITMQ_USER=korp
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__User=korp
RabbitMq__Password=
